# Auth (NextAuth/Auth.js)
AUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (Turso libSQL in production, local SQLite for dev)
# Local: DATABASE_URL="file:./dev.db"
# Production: DATABASE_URL="libsql://your-db.turso.io" + TURSO_AUTH_TOKEN
DATABASE_URL="file:./dev.db"
TURSO_AUTH_TOKEN=

# WhatsApp engine (Railway container)
WHATSAPP_ENGINE_URL=http://localhost:3001
WHATSAPP_ENGINE_TOKEN=replace-with-a-long-random-secret

# Cron job authentication (used by Vercel Cron Jobs to trigger job processing)
CRON_SECRET_TOKEN=replace-with-a-long-random-secret